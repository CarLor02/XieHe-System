{
  "name": "xiehe-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "frontend",
    "mobile-expo",
    "packages/*"
  ],
  "scripts": {
    "type-check:api": "npm run type-check --workspace @xiehe/api-client",
    "test:api": "npm run test --workspace @xiehe/api-client",
    "type-check:contracts": "npm run type-check --workspace @xiehe/api-contracts",
    "test:contracts": "npm run test --workspace @xiehe/api-contracts",
    "type-check:sdk": "npm run type-check --workspace @xiehe/api-sdk",
    "test:sdk": "npm run test --workspace @xiehe/api-sdk",
    "type-check:core": "npm run type-check --workspace @xiehe/imaging-core",
    "test:core": "npm run test --workspace @xiehe/imaging-core",
    "type-check:catalog": "npm run type-check --workspace @xiehe/imaging-catalog",
    "test:catalog": "npm run test --workspace @xiehe/imaging-catalog",
    "type-check:auth-core": "npm run type-check --workspace @xiehe/auth-core",
    "test:auth-core": "npm run test --workspace @xiehe/auth-core",
    "type-check:access-core": "npm run type-check --workspace @xiehe/access-core",
    "test:access-core": "npm run test --workspace @xiehe/access-core",
    "type-check:patient-core": "npm run type-check --workspace @xiehe/patient-core",
    "test:patient-core": "npm run test --workspace @xiehe/patient-core",
    "type-check:upload-core": "npm run type-check --workspace @xiehe/upload-core",
    "test:upload-core": "npm run test --workspace @xiehe/upload-core",
    "type-check:dashboard-core": "npm run type-check --workspace @xiehe/dashboard-core",
    "test:dashboard-core": "npm run test --workspace @xiehe/dashboard-core",
    "test:shared-boundaries": "node scripts/check-shared-package-boundaries.mjs",
    "type-check:web": "npm run type-check --workspace medical-imaging-frontend",
    "lint:web": "npm run lint --workspace medical-imaging-frontend",
    "test:web": "npm run test --workspace medical-imaging-frontend -- --runInBand",
    "build:web": "npm run build --workspace medical-imaging-frontend",
    "type-check:mobile": "npm run type-check --workspace @xiehe/mobile-expo",
    "export:mobile": "npm run export --workspace @xiehe/mobile-expo",
    "verify:core": "npm run type-check:core && npm run test:core && npm run type-check:catalog && npm run test:catalog",
    "verify:shared": "npm run type-check:auth-core && npm run test:auth-core && npm run type-check:access-core && npm run test:access-core && npm run type-check:patient-core && npm run test:patient-core && npm run type-check:upload-core && npm run test:upload-core && npm run type-check:dashboard-core && npm run test:dashboard-core && npm run test:shared-boundaries",
    "verify:api": "npm run type-check:api && npm run test:api && npm run type-check:contracts && npm run test:contracts && npm run type-check:sdk && npm run test:sdk",
    "verify:web": "npm run type-check:web && npm run test:web && npm run build:web"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
