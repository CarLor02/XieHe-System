# Used only by scripts/storage/migrate_*.sh --env-file; not loaded by the app.
MIGRATION_SOURCE_ENDPOINT=http://127.0.0.1:9000
MIGRATION_DESTINATION_ENDPOINT=http://127.0.0.1:9100
# Use the HOST-accessible MySQL address and URL-encode special password characters.
MIGRATION_DATABASE_URL=<mysql+pymysql://user:password@127.0.0.1:3306/medical_imaging_system>
# Credentials default to .env.minio and .env.rustfs. Optional independent credentials:
# MIGRATION_SOURCE_ACCESS_KEY=...
# MIGRATION_SOURCE_SECRET_KEY=...
# MIGRATION_DESTINATION_ACCESS_KEY=...
# MIGRATION_DESTINATION_SECRET_KEY=...
